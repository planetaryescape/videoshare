{
  "name": "videoshare",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev:client dev:server dev:worker",
    "dev:worker": "alchemy dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "plan": "alchemy plan",
    "tail": "alchemy tail",
    "logs": "alchemy logs",
    "check": "bun run typecheck",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "lint": "oxlint -c .oxlintrc.json apps packages",
    "lint:fix": "oxlint --fix -c .oxlintrc.json apps packages",
    "format": "oxfmt --write apps packages",
    "format:check": "oxfmt --check apps packages",
    "check-all": "bun run lint && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "turbo": "^2.9.16"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform-bun": ">=4.0.0-beta.78 || >=4.0.0",
    "@effect/platform-node": ">=4.0.0-beta.78 || >=4.0.0",
    "@effect/sql-d1": "4.0.0-beta.78",
    "@effect/sql-sqlite-bun": "4.0.0-beta.78",
    "alchemy": "^2.0.0-beta.52",
    "effect": ">=4.0.0-beta.78 || >=4.0.0"
  }
}
