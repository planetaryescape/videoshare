{
  "name": "videoshare",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:viewer-assets && alchemy dev",
    "dev:admin": "bun run dev:admin:server & sleep 1 && bun run dev:admin:client",
    "dev:admin:server": "bun --hot ./apps/admin/server.ts",
    "dev:admin:client": "cd apps/admin && bunx vite",
    "build:viewer-assets": "bun build ./apps/viewer/src/player.entry.ts --outfile ./apps/viewer/generated/player.js --target browser --format esm --minify && bun build ./apps/viewer/src/player.css --outfile ./apps/viewer/generated/player.css --target browser --minify",
    "plan": "alchemy plan",
    "tail": "alchemy tail",
    "logs": "alchemy logs",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform-bun": ">=4.0.0-beta.78 || >=4.0.0",
    "@effect/platform-node": ">=4.0.0-beta.78 || >=4.0.0",
    "@effect/sql-d1": "4.0.0-beta.78",
    "@effect/sql-sqlite-bun": "4.0.0-beta.78",
    "alchemy": "^2.0.0-beta.52",
    "effect": ">=4.0.0-beta.78 || >=4.0.0"
  }
}
