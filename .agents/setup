#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$HOME/.bun/bin:$PATH"

run_step() {
  local name="$1"
  shift
  local started
  started="$(date +%s)"
  printf '\n==> %s\n' "$name"
  "$@"
  printf '<== %s (%ss)\n' "$name" "$(( $(date +%s) - started ))"
}

missing_packages=()
for package in ca-certificates curl ffmpeg git; do
  if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  run_step "Installing system packages" apt-get update
  run_step "Installing ${missing_packages[*]}" apt-get install -y "${missing_packages[@]}"
fi

required_bun_version="1.3.14"
if ! command -v bun >/dev/null || [ "$(bun --version)" != "$required_bun_version" ]; then
  run_step "Installing Bun $required_bun_version" bash -c "curl -fsSL https://bun.sh/install | bash -s bun-v$required_bun_version"
fi
export PATH="$HOME/.bun/bin:$PATH"

mkdir -p "$HOME/.local/bin"
ln -sfn "$HOME/.bun/bin/bun" "$HOME/.local/bin/bun"

if [ "$(bun --version)" != "$required_bun_version" ]; then
  echo "Expected Bun $required_bun_version, found $(bun --version)" >&2
  exit 1
fi

run_step "Installing locked Bun dependencies" bun install --frozen-lockfile
